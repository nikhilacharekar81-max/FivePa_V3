# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection URL.
DATABASE_URL=""

# PostgreSQL Database Configuration (SQL_*)
SQL_HOST="localhost"
SQL_USER="ai_studio_app_user"
SQL_PASSWORD=""
SQL_DB_NAME="cloud_sql_development_database"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD=""

# JWT_SECRET: Optional custom secret for authentication tokens.
JWT_SECRET=""

# GATEWAY_ENCRYPTION_KEY: Secret key for encrypting payment gateway credentials.
GATEWAY_ENCRYPTION_KEY=""

# GCS_BUCKET_NAME: Google Cloud Storage bucket name for uploaded files.
GCS_BUCKET_NAME=""
